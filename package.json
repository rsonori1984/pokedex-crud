{
  "name": "pokedex-crud",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve pokedex-crud",
    "build": "ng build pokedex-crud",
    "watch": "ng build pokedex-crud --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start:host": "ng serve pokedex-crud",
    "start:weather": "ng serve mfe-weather",
    "start:all": "concurrently -n weather,host -c cyan,magenta \"npm:start:weather\" \"npm:start:host\"",
    "build:weather": "ng build mfe-weather",
    "build:all": "ng build mfe-weather && ng build pokedex-crud"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "styles": [
    "node_modules/bootstrap/dist/css/bootstrap.min.css",
    "src/styles.scss"
  ],
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^20.3.1",
    "@angular/animations": "^20.3.35",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/localize": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@primeuix/themes": "^2.0.1",
    "@softarc/native-federation-node": "^3.3.4",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "es-module-shims": "^1.5.12",
    "primeng": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.43",
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.35",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.7",
    "jasmine-core": "~5.9.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^15.0.3",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.2"
  }
}
